# Server Configuration
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/nexusmind
# For production (Render), use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/nexusmind

# Firebase Service Account (for admin operations)
# Get this from Firebase Console > Project Settings > Service Accounts
FIREBASE_SERVICE_ACCOUNT_KEY=

# JWT Secret (for additional token validation if needed)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
